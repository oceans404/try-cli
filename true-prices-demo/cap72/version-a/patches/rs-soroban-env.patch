+#[test]
+fn test_g_account_delegated_signer_is_rejected() {
+    // Deliberate departure from the CAP-72 text: only contracts can be
+    // delegated signers. A `SignerKey::ScDelegated` holding a G-address is
+    // ignored on the account, and a G-address delegate in the credentials is
+    // refused.
+    let test = Cap72Test::setup();
+    let sac = test.sac();
+    let seller = setup_seller(&test);
+    let issuer = TestSigner::account(&test.issuer_key);
+
+    // A G-account "delegate" with a single signer.
+    let cosigner_key = generate_signing_key(&test.host);
+    let cosigner_id = signing_key_to_account_id(&cosigner_key);
+    test.add_account(&cosigner_id, &[], &[], [1, 0, 0, 0]);
+
+    let wallet_key = generate_signing_key(&test.host);
+    let wallet_id = signing_key_to_account_id(&wallet_key);
+    test.add_account(
+        &wallet_id,
+        &[],
+        &[(ScAddress::Account(cosigner_id.clone()), 1)],
+        [2, 1, 1, 2],
+    );
+    test.add_trustline(&wallet_id);
+    let wallet_address = account_to_address(&test.host, wallet_id.clone());
+    sac.mint(&issuer, wallet_address.clone(), 10_000_000).unwrap();
+
+    // Build the entry by hand: the delegate is the G-account, signed with its
+    // own key the way CAP-71-01 built-in delegation would expect.
+    let args = vec![
+        ScVal::Address(ScAddress::Account(wallet_id.clone())),
+        ScVal::Address(seller.to_sc_address().unwrap()),
+        ScVal::I128(i128_parts(1_000_000)),
+    ];
+    let root_invocation = SorobanAuthorizedInvocation {
+        function: SorobanAuthorizedFunction::ContractFn(InvokeContractArgs {
+            contract_address: sac.address.to_sc_address().unwrap(),
+            function_name: "transfer".try_into().unwrap(),
+            args: args.try_into().unwrap(),
+        }),
+        sub_invocations: Default::default(),
+    };
+    let nonce: i64 = thread_rng().gen();
+    let address = ScAddress::Account(wallet_id.clone());
+    let payload = test.signature_payload(&address, &root_invocation, nonce, 1000);
+    let cosigner_sig = TestSigner::account(&cosigner_key).sign(&test.host, &payload);
+    let entry = SorobanAuthorizationEntry {
+        credentials: SorobanCredentials::AddressWithDelegates(
+            SorobanAddressCredentialsWithDelegates {
+                address_credentials: SorobanAddressCredentials {
+                    address,
+                    nonce,
+                    signature_expiration_ledger: 1000,
+                    signature: ScVal::Void,
+                },
+                delegates: vec![SorobanDelegateSignature {
+                    address: ScAddress::Account(cosigner_id.clone()),
+                    signature: cosigner_sig,
+                    nested_delegates: vec![].try_into().unwrap(),
+                }]
+                .try_into()
+                .unwrap(),
+            },
+        ),
+        root_invocation,
+    };
+    test.host.set_authorization_entries(vec![entry]).unwrap();
+    let res = test.host.call(
+        sac.address.as_object(),
+        Symbol::try_from_val(&test.host, &"transfer").unwrap(),
+        test_vec![&test.host, wallet_address.clone(), seller.clone(), 1_000_000i128].into(),
+    );
+    assert_auth_error(&res);
+    assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 10_000_000);
+
+    // The master key is unaffected.
+    sac.transfer(&TestSigner::account(&wallet_key), seller.clone(), 1_000_000)
+        .unwrap();
+    assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 9_000_000);
+}
