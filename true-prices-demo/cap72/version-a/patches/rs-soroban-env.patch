+#[test]
+fn test_delegated_signers_never_count_toward_high_threshold() {
+    // Deliberate departure from the CAP-72 text: a delegated signer's weight
+    // counts toward the med threshold only. When the authorization context
+    // contains a call on the G-account itself (an account-management call,
+    // which requires the high threshold), delegated signers are refused, even
+    // with weight 255.
+    let test = Cap72Test::setup();
+    let sac = test.sac();
+    let delegate = test.deploy_delegate();
+    let seller = setup_seller(&test);
+    let issuer = TestSigner::account(&test.issuer_key);
+
+    let wallet_key = generate_signing_key(&test.host);
+    let wallet_id = signing_key_to_account_id(&wallet_key);
+    // Master weight 1, delegate weight 255, thresholds 1/1/1: the delegate
+    // would trivially pass any threshold by weight alone.
+    test.add_account(&wallet_id, &[], &[(delegate.sc_address(), 255)], [1, 1, 1, 1]);
+    test.add_trustline(&wallet_id);
+    let wallet_address = account_to_address(&test.host, wallet_id.clone());
+    sac.mint(&issuer, wallet_address.clone(), 10_000_000).unwrap();
+
+    // Sanity check: without an account call in the context the delegate
+    // authorizes the transfer.
+    test.transfer(
+        &sac,
+        &wallet_id,
+        &seller,
+        1_000_000,
+        &[],
+        &[(&delegate, DelegateSig::Valid)],
+        true,
+    )
+    .unwrap();
+    assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 9_000_000);
+
+    // A sub-invocation on the G-account itself (what a GAC call would look
+    // like) puts an account call into the context.
+    let account_call = SorobanAuthorizedInvocation {
+        function: SorobanAuthorizedFunction::ContractFn(InvokeContractArgs {
+            contract_address: ScAddress::Account(wallet_id.clone()),
+            function_name: "set_master_weight".try_into().unwrap(),
+            args: vec![ScVal::U32(0)].try_into().unwrap(),
+        }),
+        sub_invocations: Default::default(),
+    };
+    let res = test.transfer_with_sub_invocations(
+        &sac,
+        &wallet_id,
+        &seller,
+        1_000_000,
+        vec![account_call.clone()],
+        &[],
+        &[(&delegate, DelegateSig::Valid)],
+        true,
+    );
+    assert_auth_error(&res);
+    // Mixed credentials are refused too: the delegate must not be listed at
+    // all for a high-threshold context.
+    let res = test.transfer_with_sub_invocations(
+        &sac,
+        &wallet_id,
+        &seller,
+        1_000_000,
+        vec![account_call.clone()],
+        &[&wallet_key],
+        &[(&delegate, DelegateSig::Valid)],
+        false,
+    );
+    assert_auth_error(&res);
+    assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 9_000_000);
+
+    // The master key alone passes the high threshold (the unused
+    // sub-invocation doesn't matter for authentication itself).
+    let res = test.transfer_with_sub_invocations(
+        &sac,
+        &wallet_id,
+        &seller,
+        1_000_000,
+        vec![account_call.clone()],
+        &[&wallet_key],
+        &[],
+        false,
+    );
+    if let Err(e) = &res {
+        // If the host rejects the entry for reasons other than
+        // authentication (e.g. an unconsumed sub-invocation), that is not what
+        // this test is about; it must not be an authentication error though.
+        assert!(
+            !(e.error.is_type(ScErrorType::Contract)
+                && e.error.get_code() == ContractError::AuthenticationError as u32),
+            "unexpected authentication error: {:?}",
+            e
+        );
+    } else {
+        assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 8_000_000);
+    }
+}
