+#[test]
+fn test_delegated_contract_signer_authorizes_transfer() {
+    let test = Cap72Test::setup();
+    let sac = test.sac();
+    let delegate = test.deploy_delegate();
+    let wallet = setup_demo_wallet(&test, &delegate);
+    let seller = setup_seller(&test);
+    let issuer = TestSigner::account(&test.issuer_key);
+    sac.mint(&issuer, wallet.address.clone(), 10_000_000).unwrap();
+
+    // The delegate alone (void top-level signature) reaches the med threshold.
+    test.transfer(
+        &sac,
+        &wallet.id,
+        &seller,
+        1_000_000,
+        &[],
+        &[(&delegate, DelegateSig::Valid)],
+        true,
+    )
+    .unwrap();
+    assert_eq!(sac.balance(wallet.address.clone()).unwrap(), 9_000_000);
+    assert_eq!(sac.balance(seller.clone()).unwrap(), 1_000_000);
+
+    // An empty signature vector works the same as void.
+    test.transfer(
+        &sac,
+        &wallet.id,
+        &seller,
+        1_000_000,
+        &[],
+        &[(&delegate, DelegateSig::Valid)],
+        false,
+    )
+    .unwrap();
+    assert_eq!(sac.balance(wallet.address.clone()).unwrap(), 8_000_000);
+
+    // The agent key behind the delegate is not an ed25519 signer on the
+    // account, so a plain account signature from it is rejected.
+    let res = test.transfer(
+        &sac,
+        &wallet.id,
+        &seller,
+        1_000_000,
+        &[&delegate.key],
+        &[],
+        false,
+    );
+    assert_auth_error(&res);
+    assert_eq!(sac.balance(wallet.address.clone()).unwrap(), 8_000_000);
+}
