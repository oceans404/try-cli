+/// CAP-0072: G-accounts are authenticated against the `Med` threshold, unless
+/// the authorization context contains a contract call on a G-account (a call
+/// to the G-account contract, GAC, which manages the account's own signers
+/// and thresholds); then the `High` threshold is required, matching
+/// `SetOptionsOp`.
+///
+/// This prototype doesn't implement the GAC, so such a context can only come
+/// from a sub-invocation on a G-address in an authorization entry (the call
+/// itself can't be performed). The rule is kept because
+/// `check_account_authentication` refuses to count delegated signers toward
+/// `High` at all (see there), and that refusal must stay in place once the
+/// GAC exists.
+// metering: covered by the host and components
+#[cfg(feature = "next")]
+fn required_threshold_index(
+    host: &Host,
+    authorization_manager: &AuthorizationManager,
+) -> Result<ThresholdIndexes, HostError> {
+    let context: HostVec = authorization_manager
+        .get_context_for_current_auth_check(host)?
+        .try_into_val(host)?;
+    for i in 0..context.len()? {
+        let ctx: AuthorizationContext = context.get(i)?;
+        if let AuthorizationContext::Contract(contract_ctx) = ctx {
+            if matches!(
+                contract_ctx.contract.to_sc_address()?,
+                ScAddress::Account(_)
+            ) {
+                return Ok(ThresholdIndexes::High);
+            }
+        }
+    }
+    Ok(ThresholdIndexes::Med)
+}
