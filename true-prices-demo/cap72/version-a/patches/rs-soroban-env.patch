+#[test]
+fn test_delegate_rejection_propagates() {
+    let test = Cap72Test::setup();
+    let sac = test.sac();
+    let delegate = test.deploy_delegate();
+    let wallet = setup_demo_wallet(&test, &delegate);
+    let seller = setup_seller(&test);
+    let issuer = TestSigner::account(&test.issuer_key);
+    sac.mint(&issuer, wallet.address.clone(), 10_000_000).unwrap();
+
+    // The delegate's `__check_auth` traps on a signature from the wrong key
+    // (ed25519 verification failure) and the transfer fails.
+    let wrong_key = generate_signing_key(&test.host);
+    let res = test.transfer(
+        &sac,
+        &wallet.id,
+        &seller,
+        1_000_000,
+        &[],
+        &[(&delegate, DelegateSig::WrongKey(wrong_key))],
+        true,
+    );
+    // The host wraps every failed account authentication into
+    // `Error(Auth, InvalidAction)` (see `maybe_authorize_invocation`); the
+    // delegate's own `Error(Crypto, InvalidInput)` is reported in the
+    // "failed account authentication with error" diagnostic event.
+    let err = res.err().unwrap();
+    assert!(
+        err.error.is_type(ScErrorType::Auth) && err.error.is_code(ScErrorCode::InvalidAction),
+        "unexpected error: {:?}",
+        err
+    );
+    assert_eq!(sac.balance(wallet.address.clone()).unwrap(), 10_000_000);
+    assert_eq!(sac.balance(seller.clone()).unwrap(), 0);
+
+    // A delegates-only entry that lists no delegate at all has nothing to
+    // authenticate with.
+    let res = test.transfer(&sac, &wallet.id, &seller, 1_000_000, &[], &[], true);
+    assert_auth_error(&res);
+}
