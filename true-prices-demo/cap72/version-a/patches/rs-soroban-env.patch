+/// CAP-0072: authenticates every delegated signer provided for the current
+/// authentication frame and returns the sum of their weights on `account`.
+///
+/// The delegated signer list comes from the `delegates` of the
+/// `SorobanCredentialsAddressWithDelegates` credentials (CAP-71-01). The
+/// tracker that produced it has already rejected unsorted and duplicate
+/// addresses when the credentials were parsed, so every address here is
+/// unique.
+///
+/// For every delegate:
+/// - it must be a contract address. This prototype deliberately departs from
+///   the CAP-72 text, which also allows G-account delegates: a contract
+///   delegate displays as its existing C strkey everywhere, so no new strkey
+///   is needed, and a G-account co-signer is already expressible with plain
+///   ed25519 signers;
+/// - it must be stored on the `AccountEntry` as a `SignerKey::ScDelegated`
+///   signer with non-zero weight (the lookup never matches ed25519 signers or
+///   the master key);
+/// - `delegate_account_auth` must succeed for it. That runs the delegate's
+///   `__check_auth` with the same signature payload and context as the
+///   account itself, and any error propagates unchanged.
+///
+/// Delegated signers are only ever consulted here, for Soroban authorization
+/// entries. Classic transaction signatures are verified by stellar-core,
+/// which ignores `SignerKey::ScDelegated`.
+// metering: covered by the host and components
+#[cfg(feature = "next")]
+fn authenticate_delegated_signers(
+    host: &Host,
+    authorization_manager: &AuthorizationManager,
+    account: &AccountEntry,
+    delegated_signers: &HostVec,
+) -> Result<u32, HostError> {
+    let mut weight = 0u32;
+    for i in 0..delegated_signers.len()? {
+        let delegate: Address = delegated_signers.get(i)?;
+        let delegate_sc_address = delegate.to_sc_address()?;
+        if !matches!(delegate_sc_address, ScAddress::Contract(_)) {
+            return Err(err!(
+                host,
+                ContractError::AuthenticationError,
+                "delegated signer must be a contract address",
+                delegate
+            ));
+        }
+        let signer_weight =
+            host.get_delegated_signer_weight_from_account(&delegate_sc_address, account)?;
+        // 0 weight indicates that the delegated signer doesn't belong to this
+        // account. Like for ed25519 signatures, treat this as an error even if
+        // the other signers would have enough weight.
+        if signer_weight == 0 {
+            return Err(err!(
+                host,
+                ContractError::AuthenticationError,
+                "delegated signer does not belong to account",
+                delegate
+            ));
+        }
+        // This runs the delegate's authentication (`__check_auth` for a
+        // contract, `check_account_authentication` for a G-account) with the
+        // signature payload and context of the current authentication frame,
+        // and marks the delegate as used in the tracker.
+        authorization_manager.delegate_account_auth(host, delegate.as_object())?;
+        weight = weight.saturating_add(signer_weight as u32);
+    }
+    Ok(weight)
+}
