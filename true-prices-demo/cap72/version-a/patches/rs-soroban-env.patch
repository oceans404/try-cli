@@ -0,0 +1,857 @@
+//! CAP-0072 prototype tests: delegated (contract) signers on G-accounts.
+//!
+//! The scenario mirrors the agent wallet demo: a plain G-account holds a
+//! Stellar asset balance, a custom account contract (`SIMPLE_ACCOUNT_CONTRACT`,
+//! which verifies an ed25519 signature over the payload) is added to the
+//! account as a `SignerKey::ScDelegated` signer via the `AccountEntry`, and
+//! the account authorizes a token `transfer` with a
+//! `SorobanCredentialsAddressWithDelegates` entry that carries the delegate's
+//! signature and no signature of its own.
+use ed25519_dalek::{Signer as _, SigningKey};
+use rand::{thread_rng, Rng};
+use soroban_test_wasms::SIMPLE_ACCOUNT_CONTRACT;
+
+use crate::builtin_contracts::base_types::{Address, BytesN};
+use crate::builtin_contracts::contract_error::ContractError;
+use crate::builtin_contracts::stellar_asset_contract::test_stellar_asset_contract::TestStellarAssetContract;
+use crate::builtin_contracts::testutils::{
+    account_to_address, generate_signing_key, new_ledger_entry_from_data,
+    sign_payload_for_account, signing_key_to_account_id, TestSigner,
+};
+use crate::xdr::{
+    AccountEntry, AccountEntryExt, AccountId, AlphaNum4, Asset, AssetCode4, HashIdPreimage,
+    Int128Parts, HashIdPreimageSorobanAuthorizationWithAddress, InvokeContractArgs,
+    LedgerEntryData, ScAddress, ScBytes, ScErrorCode, ScErrorType, ScVal, ScVec, SequenceNumber,
+    Signer, SignerKey, SorobanAddressCredentials, SorobanAddressCredentialsWithDelegates,
+    SorobanAuthorizationEntry, SorobanAuthorizedFunction, SorobanAuthorizedInvocation,
+    SorobanCredentials, SorobanDelegateSignature, Thresholds, TrustLineEntry, TrustLineEntryExt,
+    TrustLineFlags, Uint256,
+};
+use crate::{Env, Host, HostError, LedgerInfo, Symbol, TryFromVal, TryIntoVal, Val};
+
+fn i128_parts(v: i128) -> Int128Parts {
+    Int128Parts {
+        hi: (v >> 64) as i64,
+        lo: v as u64,
+    }
+}
+
+/// A delegate contract: `SIMPLE_ACCOUNT_CONTRACT` initialized with `key`'s
+/// public key. Its `__check_auth` takes a `BytesN<64>` signature and traps if
+/// it doesn't verify against the stored key.
+struct Delegate {
+    address: Address,
+    key: SigningKey,
+}
+
+impl Delegate {
+    fn sc_address(&self) -> ScAddress {
+        self.address.to_sc_address().unwrap()
+    }
+
+    fn sign(&self, payload: &[u8; 32]) -> ScVal {
+        ScVal::Bytes(ScBytes(
+            self.key.sign(payload).to_bytes().to_vec().try_into().unwrap(),
+        ))
+    }
+
+    fn sign_with(&self, key: &SigningKey, payload: &[u8; 32]) -> ScVal {
+        ScVal::Bytes(ScBytes(
+            key.sign(payload).to_bytes().to_vec().try_into().unwrap(),
+        ))
+    }
+}
+
+/// What the G-account puts in the auth entry.
+enum DelegateSig {
+    /// A correctly signed delegate entry.
+    Valid,
+    /// A delegate entry signed with a key the delegate doesn't know.
+    WrongKey(SigningKey),
+}
+
+struct Cap72Test {
+    host: Host,
+    issuer_key: SigningKey,
+    asset_code: [u8; 4],
+}
+
+impl Cap72Test {
+    fn setup() -> Self {
+        let host = Host::test_host_with_recording_footprint();
+        let protocol_version = host.get_ledger_protocol_version().unwrap();
+        host.set_ledger_info(LedgerInfo {
+            protocol_version,
+            sequence_number: 123,
+            timestamp: 123456,
+            network_id: [7; 32],
+            base_reserve: 5_000_000,
+            min_persistent_entry_ttl: 4096,
+            min_temp_entry_ttl: 16,
+            max_entry_ttl: 6_312_000,
+        })
+        .unwrap();
+        host.enable_debug().unwrap();
+        Self {
+            host: host.clone(),
+            issuer_key: generate_signing_key(&host),
+            asset_code: *b"USDC",
+        }
+    }
+
+    fn issuer_id(&self) -> AccountId {
+        signing_key_to_account_id(&self.issuer_key)
+    }
+
+    fn sac(&self) -> TestStellarAssetContract<'_> {
+        self.add_account(&self.issuer_id(), &[(&self.issuer_key, 1)], &[], [1, 0, 0, 0]);
+        let asset = Asset::CreditAlphanum4(AlphaNum4 {
+            asset_code: AssetCode4(self.asset_code),
+            issuer: self.issuer_id(),
+        });
+        TestStellarAssetContract::new_from_asset(&self.host, asset).unwrap()
+    }
+
+    /// Adds an `AccountEntry` with ed25519 signers and CAP-0072 delegated
+    /// signers. `thresholds` is `[master weight, low, med, high]`.
+    fn add_account(
+        &self,
+        account_id: &AccountId,
+        ed25519_signers: &[(&SigningKey, u32)],
+        delegated_signers: &[(ScAddress, u32)],
+        thresholds: [u8; 4],
+    ) {
+        let key = self.host.to_account_key(account_id.clone()).unwrap();
+        let mut signers = vec![];
+        for (signer, weight) in ed25519_signers {
+            signers.push(Signer {
+                key: SignerKey::Ed25519(Uint256(signer.verifying_key().to_bytes())),
+                weight: *weight,
+            });
+        }
+        for (address, weight) in delegated_signers {
+            signers.push(Signer {
+                key: SignerKey::ScDelegated(address.clone()),
+                weight: *weight,
+            });
+        }
+        let acc_entry = AccountEntry {
+            account_id: account_id.clone(),
+            balance: 100_000_000,
+            seq_num: SequenceNumber(0),
+            num_sub_entries: signers.len() as u32,
+            inflation_dest: None,
+            flags: 0,
+            home_domain: Default::default(),
+            thresholds: Thresholds(thresholds),
+            signers: signers.try_into().unwrap(),
+            ext: AccountEntryExt::V0,
+        };
+        self.host
+            .add_ledger_entry(
+                &key,
+                &new_ledger_entry_from_data(LedgerEntryData::Account(acc_entry)),
+                None,
+            )
+            .unwrap();
+    }
+
+    fn add_trustline(&self, account_id: &AccountId) {
+        let asset = self.host.create_tl_asset_4(self.asset_code, self.issuer_id());
+        let key = self
+            .host
+            .to_trustline_key(account_id.clone(), asset.clone())
+            .unwrap();
+        let trustline_entry = TrustLineEntry {
+            account_id: account_id.clone(),
+            asset,
+            balance: 0,
+            limit: i64::MAX,
+            flags: TrustLineFlags::AuthorizedFlag as u32,
+            ext: TrustLineEntryExt::V0,
+        };
+        self.host
+            .add_ledger_entry(
+                &key,
+                &new_ledger_entry_from_data(LedgerEntryData::Trustline(trustline_entry)),
+                None,
+            )
+            .unwrap();
+    }
+
+    fn deploy_delegate(&self) -> Delegate {
+        let key = generate_signing_key(&self.host);
+        let address_obj = self.host.register_test_contract_wasm(SIMPLE_ACCOUNT_CONTRACT);
+        let pk = BytesN::<32>::from_slice(&self.host, &key.verifying_key().to_bytes()).unwrap();
+        self.host
+            .call(
+                address_obj,
+                Symbol::try_from_val(&self.host, &"init").unwrap(),
+                test_vec![&self.host, pk].into(),
+            )
+            .unwrap();
+        Delegate {
+            address: Address::try_from_val(&self.host, &address_obj).unwrap(),
+            key,
+        }
+    }
+
+    fn signature_payload(
+        &self,
+        address: &ScAddress,
+        root_invocation: &SorobanAuthorizedInvocation,
+        nonce: i64,
+        signature_expiration_ledger: u32,
+    ) -> [u8; 32] {
+        let network_id = self
+            .host
+            .with_ledger_info(|li: &LedgerInfo| Ok(li.network_id))
+            .unwrap()
+            .try_into()
+            .unwrap();
+        self.host
+            .metered_hash_xdr(&HashIdPreimage::SorobanAuthorizationWithAddress(
+                HashIdPreimageSorobanAuthorizationWithAddress {
+                    network_id,
+                    invocation: root_invocation.clone(),
+                    address: address.clone(),
+                    nonce,
+                    signature_expiration_ledger,
+                },
+            ))
+            .unwrap()
+    }
+
+    /// Builds one `SorobanCredentialsAddressWithDelegates` auth entry for the
+    /// G-account `wallet` authorizing `fn_name(args)` on `contract`, with the
+    /// provided ed25519 signatures and delegate signatures.
+    #[allow(clippy::too_many_arguments)]
+    fn build_auth_entry(
+        &self,
+        wallet: &AccountId,
+        contract: &Address,
+        fn_name: &str,
+        args: Vec<ScVal>,
+        sub_invocations: Vec<SorobanAuthorizedInvocation>,
+        ed25519_signers: &[&SigningKey],
+        delegates: &[(&Delegate, DelegateSig)],
+        signature_is_void: bool,
+    ) -> SorobanAuthorizationEntry {
+        let root_invocation = SorobanAuthorizedInvocation {
+            function: SorobanAuthorizedFunction::ContractFn(InvokeContractArgs {
+                contract_address: contract.to_sc_address().unwrap(),
+                function_name: fn_name.try_into().unwrap(),
+                args: args.try_into().unwrap(),
+            }),
+            sub_invocations: sub_invocations.try_into().unwrap(),
+        };
+        let nonce: i64 = thread_rng().gen();
+        let signature_expiration_ledger = 1000;
+        let address = ScAddress::Account(wallet.clone());
+        let payload = self.signature_payload(
+            &address,
+            &root_invocation,
+            nonce,
+            signature_expiration_ledger,
+        );
+
+        let signature = if signature_is_void {
+            ScVal::Void
+        } else {
+            let mut keys: Vec<&SigningKey> = ed25519_signers.to_vec();
+            keys.sort_by_key(|k| *k.verifying_key().as_bytes());
+            let sigs: Vec<Val> = keys
+                .iter()
+                .map(|k| sign_payload_for_account(&self.host, k, &payload).try_into_val(&self.host).unwrap())
+                .collect();
+            ScVal::Vec(Some(ScVec(
+                self.host.vals_to_scval_vec(sigs.as_slice()).unwrap(),
+            )))
+        };
+
+        let mut delegate_sigs: Vec<SorobanDelegateSignature> = delegates
+            .iter()
+            .map(|(d, how)| SorobanDelegateSignature {
+                address: d.sc_address(),
+                signature: match how {
+                    DelegateSig::Valid => d.sign(&payload),
+                    DelegateSig::WrongKey(k) => d.sign_with(k, &payload),
+                },
+                nested_delegates: vec![].try_into().unwrap(),
+            })
+            .collect();
+        delegate_sigs.sort_by(|a, b| a.address.cmp(&b.address));
+
+        SorobanAuthorizationEntry {
+            credentials: SorobanCredentials::AddressWithDelegates(
+                SorobanAddressCredentialsWithDelegates {
+                    address_credentials: SorobanAddressCredentials {
+                        address,
+                        nonce,
+                        signature_expiration_ledger,
+                        signature,
+                    },
+                    delegates: delegate_sigs.try_into().unwrap(),
+                },
+            ),
+            root_invocation,
+        }
+    }
+
+    /// `transfer(wallet, to, amount)` on the SAC, authorized by `wallet` with
+    /// the given signers.
+    #[allow(clippy::too_many_arguments)]
+    fn transfer(
+        &self,
+        sac: &TestStellarAssetContract<'_>,
+        wallet: &AccountId,
+        to: &Address,
+        amount: i128,
+        ed25519_signers: &[&SigningKey],
+        delegates: &[(&Delegate, DelegateSig)],
+        signature_is_void: bool,
+    ) -> Result<Val, HostError> {
+        self.transfer_with_sub_invocations(
+            sac,
+            wallet,
+            to,
+            amount,
+            vec![],
+            ed25519_signers,
+            delegates,
+            signature_is_void,
+        )
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn transfer_with_sub_invocations(
+        &self,
+        sac: &TestStellarAssetContract<'_>,
+        wallet: &AccountId,
+        to: &Address,
+        amount: i128,
+        sub_invocations: Vec<SorobanAuthorizedInvocation>,
+        ed25519_signers: &[&SigningKey],
+        delegates: &[(&Delegate, DelegateSig)],
+        signature_is_void: bool,
+    ) -> Result<Val, HostError> {
+        let wallet_address = account_to_address(&self.host, wallet.clone());
+        let args = vec![
+            ScVal::Address(ScAddress::Account(wallet.clone())),
+            ScVal::Address(to.to_sc_address().unwrap()),
+            ScVal::I128(i128_parts(amount)),
+        ];
+        let entry = self.build_auth_entry(
+            wallet,
+            &sac.address,
+            "transfer",
+            args,
+            sub_invocations,
+            ed25519_signers,
+            delegates,
+            signature_is_void,
+        );
+        self.host.set_authorization_entries(vec![entry])?;
+        self.host.call(
+            sac.address.as_object(),
+            Symbol::try_from_val(&self.host, &"transfer").unwrap(),
+            test_vec![&self.host, wallet_address, to.clone(), amount].into(),
+        )
+    }
+}
+
+/// The wallet from the demo: master weight 2, one delegated signer of weight
+/// 1, thresholds low 1, med 1, high 2.
+struct Wallet {
+    id: AccountId,
+    address: Address,
+    key: SigningKey,
+}
+
+fn setup_demo_wallet(test: &Cap72Test, delegate: &Delegate) -> Wallet {
+    let key = generate_signing_key(&test.host);
+    let id = signing_key_to_account_id(&key);
+    test.add_account(&id, &[], &[(delegate.sc_address(), 1)], [2, 1, 1, 2]);
+    test.add_trustline(&id);
+    Wallet {
+        address: account_to_address(&test.host, id.clone()),
+        id,
+        key,
+    }
+}
+
+fn setup_seller(test: &Cap72Test) -> Address {
+    let key = generate_signing_key(&test.host);
+    let id = signing_key_to_account_id(&key);
+    test.add_account(&id, &[], &[], [1, 0, 0, 0]);
+    test.add_trustline(&id);
+    account_to_address(&test.host, id)
+}
+
+fn assert_auth_error(res: &Result<Val, HostError>) {
+    let err = res.as_ref().err().expect("expected an error");
+    assert!(
+        err.error.is_type(ScErrorType::Contract)
+            && err.error.get_code() == ContractError::AuthenticationError as u32
+            || err.error.is_type(ScErrorType::Auth),
+        "unexpected error: {:?}",
+        err
+    );
+}
