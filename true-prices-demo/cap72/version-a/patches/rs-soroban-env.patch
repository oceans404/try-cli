+#[test]
+fn test_plain_ed25519_account_is_unchanged() {
+    let test = Cap72Test::setup();
+    let sac = test.sac();
+    let delegate = test.deploy_delegate();
+    let wallet = setup_demo_wallet(&test, &delegate);
+    let seller = setup_seller(&test);
+    let issuer = TestSigner::account(&test.issuer_key);
+    sac.mint(&issuer, wallet.address.clone(), 10_000_000).unwrap();
+
+    // The master key still works through the regular `SorobanCredentials::Address`
+    // path (the stock test client), even though a delegated signer is on the
+    // account.
+    sac.transfer(&TestSigner::account(&wallet.key), seller.clone(), 1_000_000)
+        .unwrap();
+    assert_eq!(sac.balance(wallet.address.clone()).unwrap(), 9_000_000);
+
+    // And through `AddressWithDelegates` credentials with an empty delegate
+    // list.
+    test.transfer(
+        &sac,
+        &wallet.id,
+        &seller,
+        1_000_000,
+        &[&wallet.key],
+        &[],
+        false,
+    )
+    .unwrap();
+    assert_eq!(sac.balance(wallet.address.clone()).unwrap(), 8_000_000);
+
+    // A void signature without delegates is still "no account signatures".
+    let res = test.transfer(&sac, &wallet.id, &seller, 1_000_000, &[], &[], true);
+    assert_auth_error(&res);
+
+    // An account without any delegated signers behaves as before.
+    let plain_key = generate_signing_key(&test.host);
+    let plain_id = signing_key_to_account_id(&plain_key);
+    test.add_account(&plain_id, &[], &[], [1, 0, 0, 0]);
+    test.add_trustline(&plain_id);
+    let plain_address = account_to_address(&test.host, plain_id.clone());
+    sac.mint(&issuer, plain_address.clone(), 5_000_000).unwrap();
+    sac.transfer(&TestSigner::account(&plain_key), seller.clone(), 1_000_000)
+        .unwrap();
+    assert_eq!(sac.balance(plain_address.clone()).unwrap(), 4_000_000);
+    // A delegate that the plain account never added is rejected.
+    let res = test.transfer(
+        &sac,
+        &plain_id,
+        &seller,
+        1_000_000,
+        &[],
+        &[(&delegate, DelegateSig::Valid)],
+        true,
+    );
+    assert_auth_error(&res);
+    assert_eq!(sac.balance(plain_address.clone()).unwrap(), 4_000_000);
+}
