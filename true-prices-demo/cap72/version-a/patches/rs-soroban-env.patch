+#[test]
+fn test_delegate_weight_below_threshold_is_rejected() {
+    let test = Cap72Test::setup();
+    let sac = test.sac();
+    let delegate = test.deploy_delegate();
+    let delegate_2 = test.deploy_delegate();
+    let seller = setup_seller(&test);
+    let issuer = TestSigner::account(&test.issuer_key);
+
+    // med threshold 2, delegate weight 1, plus an ed25519 co-signer of weight 1.
+    let cosigner = generate_signing_key(&test.host);
+    let wallet_key = generate_signing_key(&test.host);
+    let wallet_id = signing_key_to_account_id(&wallet_key);
+    test.add_account(
+        &wallet_id,
+        &[(&cosigner, 1)],
+        &[(delegate.sc_address(), 1), (delegate_2.sc_address(), 1)],
+        [3, 1, 2, 3],
+    );
+    test.add_trustline(&wallet_id);
+    let wallet_address = account_to_address(&test.host, wallet_id.clone());
+    sac.mint(&issuer, wallet_address.clone(), 10_000_000).unwrap();
+
+    // One delegate: weight 1 < 2.
+    let res = test.transfer(
+        &sac,
+        &wallet_id,
+        &seller,
+        1_000_000,
+        &[],
+        &[(&delegate, DelegateSig::Valid)],
+        true,
+    );
+    assert_auth_error(&res);
+    assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 10_000_000);
+
+    // Delegate + ed25519 co-signer: 1 + 1 = 2.
+    test.transfer(
+        &sac,
+        &wallet_id,
+        &seller,
+        1_000_000,
+        &[&cosigner],
+        &[(&delegate, DelegateSig::Valid)],
+        false,
+    )
+    .unwrap();
+    assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 9_000_000);
+
+    // Two delegates: 1 + 1 = 2.
+    test.transfer(
+        &sac,
+        &wallet_id,
+        &seller,
+        1_000_000,
+        &[],
+        &[
+            (&delegate, DelegateSig::Valid),
+            (&delegate_2, DelegateSig::Valid),
+        ],
+        true,
+    )
+    .unwrap();
+    assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 8_000_000);
+
+    // Two delegates where one fails: the whole authentication fails.
+    let wrong_key = generate_signing_key(&test.host);
+    let res = test.transfer(
+        &sac,
+        &wallet_id,
+        &seller,
+        1_000_000,
+        &[],
+        &[
+            (&delegate, DelegateSig::Valid),
+            (&delegate_2, DelegateSig::WrongKey(wrong_key)),
+        ],
+        true,
+    );
+    assert!(res.is_err());
+    assert_eq!(sac.balance(wallet_address.clone()).unwrap(), 8_000_000);
+}
