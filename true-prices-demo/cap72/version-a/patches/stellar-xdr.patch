 };
 
 union SetOptionsResult switch (SetOptionsResultCode code)
@@ -1424,6 +1429,10 @@ case SET_OPTIONS_BAD_SIGNER:
 case SET_OPTIONS_INVALID_HOME_DOMAIN:
 case SET_OPTIONS_AUTH_REVOCABLE_REQUIRED:
