+#endif
     }
     result;
 
@@ -2118,6 +2138,10 @@ struct TransactionResult
     case txSOROBAN_INVALID:
     case txFROZEN_KEY_ACCESSED:
         void;
+#ifdef CAP_0072_DELEGATED_SIGNERS
+    case txACCOUNT_DELEGATED_SIGNER_NOT_SUPPORTED:
+        void;
+#endif
     }
     result;
 
diff --git a/Stellar-types.x b/Stellar-types.x
