 };
 
 /******* ChangeTrust Result ********/
@@ -2037,6 +2046,13 @@ enum TransactionResultCode
     txMALFORMED = -16,              // precondition is invalid
     txSOROBAN_INVALID = -17,        // soroban-specific preconditions were not met
     txFROZEN_KEY_ACCESSED = -18     // a 'frozen' ledger key is accessed by any operation
+#ifdef CAP_0072_DELEGATED_SIGNERS
+    ,
+    // Transaction had an extra signer of type SIGNER_KEY_TYPE_SC_DELEGATED,
+    // which is not supported. (CAP-0072 text says -18; that code is taken by
+    // txFROZEN_KEY_ACCESSED on main, so the prototype uses -19.)
+    txACCOUNT_DELEGATED_SIGNER_NOT_SUPPORTED = -19
+#endif
 };
 
