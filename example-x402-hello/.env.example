# Copy to .env (never commit .env). On a host like Render, set these as
# environment variables instead.
# stellar:testnet or stellar:pubnet (mainnet)
STELLAR_NETWORK=stellar:testnet
PORT=3004

# Built on Stellar (OpenZeppelin Channels) facilitator keys, one per network.
# Testnet: GET https://channels.openzeppelin.com/testnet/gen
# Mainnet: https://channels.openzeppelin.com/gen (GitHub login)
OZ_API_KEY_TESTNET=
OZ_API_KEY_MAINNET=

# G... address that receives payments. It needs a USDC trustline, and on
# mainnet a USDT0 trustline too.
STELLAR_RECIPIENT=

# Optional: price per call in 7-decimal units (default 10000 = 0.001).
# PRICE_UNITS=10000
