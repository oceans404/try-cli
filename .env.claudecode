# What a Claude Code cloud environment needs for this repo.
# Set these in the environment's settings (environment menu > Edit), NOT in a
# file: new sessions pick them up. Never put real values in this file.

# --- Environment variables ---------------------------------------------------

# Privy App Secret for privy-wallet/ (the secure/mainnet wallet). Optional.
# Claude uses it only when asked, per task (CLAUDE.md > Rules).
PRIVY_APP_SECRET=

# Lets Node's fetch (x402 clients, privy.mjs buy) use the cloud proxy.
# Recommended; without it, pass it per command.
NODE_USE_ENV_PROXY=1

# Not secret, so they aren't needed here: the Privy App ID
# (cmrpejbk700es0ckwpdu1hxcj) is in CLAUDE.md and privy-wallet/wallet.json.

# --- Setup script --------------------------------------------------------------
# Paste scripts/setup.sh so each session starts with the Stellar CLI built
# (~/.stellar-main/bin/stellar). Without it, the first session spends 5-15 min
# building.

# --- Network access ------------------------------------------------------------
# Hosts this repo reaches (all reachable under this environment's policy, checked 2026-09-24):
#   soroban-testnet.stellar.org, friendbot.stellar.org, horizon-testnet.stellar.org
#   mainnet.sorobanrpc.com, horizon.stellar.org       (mainnet reads)
#   api.privy.io                                      (privy-wallet)
#   developers.stellar.org, skills.stellar.org        (docs)
#   testnet.rgstry.xyz, stellar.rgstry.xyz            (contract registry)
#   explorer-explorer.up.railway.app, *.up.railway.app, try-cli-jukj.onrender.com (x402 sellers)
#   channels.openzeppelin.com, facilitator.rail402.dev (x402 facilitators)
#   github.com, crates.io, registry.npmjs.org         (building the CLI, npm)

# --- Connectors (claude.ai > Settings > Connectors, before the session) ---------
# Raven MCP: https://raven.stellar.org/mcp   (optional; needs browser sign-in)
