# Copy to .env (never commit .env). On a host like Render, set these as
# environment variables instead.
STELLAR_NETWORK=stellar:testnet
# G... address that receives USDC; it needs a USDC trustline.
STELLAR_RECIPIENT=
PORT=3001

# Pick one facilitator.
#
# OZ Channels (default): testnet and mainnet, API key required.
#   Testnet key: GET https://channels.openzeppelin.com/testnet/gen
#   Mainnet key: https://channels.openzeppelin.com/gen
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
OZ_API_KEY=
#
# Rail402: testnet only, no key, and it lists the route in the Rail402 Bazaar
# after the first settled payment. Leave OZ_API_KEY empty.
# FACILITATOR_URL=https://facilitator.rail402.dev

# Mainnet (OZ Channels): STELLAR_NETWORK=stellar:pubnet,
# FACILITATOR_URL=https://channels.openzeppelin.com/x402, a mainnet OZ_API_KEY,
# and a mainnet STELLAR_RECIPIENT.
