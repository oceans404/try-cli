# Copy to .env (never commit .env).
STELLAR_NETWORK=stellar:testnet
FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# Testnet key: GET https://channels.openzeppelin.com/testnet/gen
# Mainnet key: https://channels.openzeppelin.com/gen
OZ_API_KEY=
# G... address that receives USDC; it needs a USDC trustline.
STELLAR_RECIPIENT=
PORT=3001

# Mainnet: STELLAR_NETWORK=stellar:pubnet,
# FACILITATOR_URL=https://channels.openzeppelin.com/x402, a mainnet OZ_API_KEY,
# and a mainnet STELLAR_RECIPIENT.
