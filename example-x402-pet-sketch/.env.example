# Copy to .env (never commit .env). On Render, set these as environment variables.
# OpenAI key for gpt-image-1 (the drawing step). Billed to this account per sketch.
OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1

# PAYWALL=off serves /sketch free and enables the upload demo at /. Remove it to charge.
PAYWALL=off
PORT=3002

STELLAR_NETWORK=stellar:testnet
# G... address that receives USDC; it needs a USDC trustline.
STELLAR_RECIPIENT=

# Rail402 (default): testnet, no key, lists the service in the Rail402 Bazaar
# after the first settled payment. Only use it on a public URL.
FACILITATOR_URL=https://facilitator.rail402.dev
# OZ Channels: testnet and mainnet, needs a key. Use it for local paid testing.
# FACILITATOR_URL=https://channels.openzeppelin.com/x402/testnet
# OZ_API_KEY=
